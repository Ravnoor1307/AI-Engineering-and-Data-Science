





import numpy as np
import pandas as pd

pd.set_option('display.width', 120)
pd.set_option('display.max_columns', 30)
np.random.seed(0)
print('pandas', pd.__version__)











def reversed_digits(n):
    return [int(d) for d in str(abs(n))][::-1]

assert reversed_digits(1230) == [0, 3, 2, 1]
print('ok')








def freq(text):
    out = {}
    for w in text.lower().split():
        out[w] = out.get(w, 0) + 1
    return out

assert freq('a b a')['a'] == 2
print('ok')








def longest(text):
    return max(text.split(), key=len)

assert longest('data science is powerful') == 'powerful'
print('ok')








def fb(n):
    return ['FizzBuzz' if i % 15 == 0 else 'Fizz' if i % 3 == 0 else 'Buzz' if i % 5 == 0 else str(i) for i in range(1, n + 1)]

assert fb(15)[-1] == 'FizzBuzz'
print('ok')








def anagram(a, b):
    if len(a) != len(b):
        return False
    tally = {}
    for ch in a:
        tally[ch] = tally.get(ch, 0) + 1
    for ch in b:
        tally[ch] = tally.get(ch, 0) - 1
        if tally[ch] < 0:
            return False
    return True

assert anagram('listen', 'silent')
print('ok')








def running_max(values):
    out, best = [], float('-inf')
    for v in values:
        best = max(best, v)
        out.append(best)
    return out

assert running_max([2, 5, 3, 9]) == [2, 5, 5, 9]
print('ok')








def flatten(nested):
    return [x for sub in nested for x in sub]

assert flatten([[1, 2], [3]]) == [1, 2, 3]
print('ok')








def pairs(values, target):
    seen, out = set(), []
    for v in values:
        if target - v in seen:
            out.append((target - v, v))
        seen.add(v)
    return out

assert pairs([1, 3, 2, 4], 5) == [(3, 2), (1, 4)]
print('ok')








def compress(s):
    if not s:
        return ''
    out, prev, n = [], s[0], 0
    for ch in s:
        if ch == prev:
            n += 1
        else:
            out.append(f'{prev}{n}')
            prev, n = ch, 1
    out.append(f'{prev}{n}')
    return ''.join(out)

assert compress('aaabb') == 'a3b2'
print('ok')








def balanced(s):
    pairs = {')': '(', ']': '[', '}': '{'}
    stack = []
    for ch in s:
        if ch in '([{':
            stack.append(ch)
        elif ch in pairs:
            if not stack or stack.pop() != pairs[ch]:
                return False
    return not stack

assert balanced('{[()]}')
assert not balanced('(]')
print('ok')















