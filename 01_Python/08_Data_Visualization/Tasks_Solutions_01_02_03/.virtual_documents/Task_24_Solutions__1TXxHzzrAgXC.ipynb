ax.plot_surface(xx,yy,z,cmap='viridis')
ax.set_xlabel('X')
ax.set_ylabel('Y')
ax.set_zlabel('Z')

plt.show()


fig = plt.figure()
ax = plt.subplot()

ax.contour(xx,yy,z,cmap='viridis')
