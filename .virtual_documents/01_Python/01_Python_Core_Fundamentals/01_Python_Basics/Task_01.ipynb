# Write your code here
heads = 4
legs = 14
# dog + chicken = head
# 4*dog + 2*chicken = legs
# 2*chicken = legs - 4*dog
# 2*dog + legs - 4*dog = 2*head
# -2*dog + legs  = 2*head
# 2*dog = legs - 2*head
# legs - 2*head + 2*chicken = 2*head
chicken = (4*heads - legs)/2
dog = (legs - 2*heads)/2
print(chicken,dog,sep='         ')





